{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Librelog Staging",
  "mainBinaryName": "librelog-staging",
  "identifier": "com.arturgrr.librelog.staging",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["librelog-staging"]
      }
    },
    "updater": {
      "active": false
    }
  },
  "bundle": {
    "icon": [
      "icons/staging/32x32.png",
      "icons/staging/128x128.png",
      "icons/staging/128x128@2x.png",
      "icons/staging/icon.icns",
      "icons/staging/icon.ico"
    ],
    "macOS": {
      "files": {
        "Resources/mlx-swift_Cmlx.bundle/default.metallib": "resources/mlx.metallib",
        "Resources/AppIcon.icns": "resources/graphite/AppIcon.icns"
      },
      "dmg": {
        "background": "assets/dmg-background-staging.png"
      }
    }
  }
}
