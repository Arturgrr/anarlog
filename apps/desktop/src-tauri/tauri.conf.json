{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anarlog Dev",
  "mainBinaryName": "anarlog-dev",
  "identifier": "com.hyprnote.dev",
  "build": {
    "features": ["direct-distribution"],
    "beforeDevCommand": "pnpm -F desktop dev",
    "devUrl": "http://localhost:1422",
    "beforeBuildCommand": "pnpm -F desktop build",
    "beforeBundleCommand": "node ./src-tauri/scripts/before-bundle.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": false,
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**/*",
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "publisher": "Fastrepl",
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libpipewire-0.3-0",
          "libpulse0",
          "libasound2",
          "libssl3",
          "libstdc++6",
          "ca-certificates",
          "desktop-file-utils",
          "xdg-utils",
          "libayatana-appindicator3-1"
        ]
      }
    },
    "externalBin": [],
    "icon": [
      "icons/dev/32x32.png",
      "icons/dev/128x128.png",
      "icons/dev/128x128@2x.png",
      "icons/dev/icon.icns",
      "icons/dev/icon.ico"
    ],
    "resources": {
      "../../../plugins/windows/swift-lib/src/Resources/CabinSketch-Regular.ttf": "CabinSketch-Regular.ttf",
      "../../../plugins/windows/swift-lib/src/Resources/OFL.txt": "CabinSketch-OFL.txt",
      "resources/graphite/AppIcon.icns": "icons/graphite.icns",
      "resources/light/AppIcon.icns": "icons/light.icns",
      "resources/notification-icons": "notification-icons",
      "../../../LICENSE": "licenses/LICENSE",
      "../../../THIRD_PARTY_NOTICES.md": "licenses/THIRD_PARTY_NOTICES.md",
      "../../../licenses/Apache-2.0.txt": "licenses/Apache-2.0.txt",
      "../../../licenses/BSD-2-Clause-AudioCap.txt": "licenses/BSD-2-Clause-AudioCap.txt",
      "../../../licenses/MIT.txt": "licenses/MIT.txt",
      "../../../crates/mp3/LICENSE-LAME.txt": "licenses/LICENSE-LAME.txt",
      "../../../crates/export-core/fonts/OFL.txt": "licenses/Pretendard-OFL.txt"
    },
    "macOS": {
      "minimumSystemVersion": "15.0",
      "entitlements": "./Entitlements.plist",
      "dmg": {
        "background": "assets/dmg-background-stable.png",
        "windowSize": {
          "width": 660,
          "height": 430
        },
        "appPosition": {
          "x": 177,
          "y": 200
        },
        "applicationFolderPosition": {
          "x": 483,
          "y": 200
        }
      },
      "files": {
        "Resources/mlx-swift_Cmlx.bundle/default.metallib": "resources/mlx.metallib",
        "Resources/AppIcon.icns": "resources/light/AppIcon.icns"
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "anarlog-dev",
          "hypr",
          "char"
        ]
      }
    },
    "updater": {
      "active": false,
      "dialog": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2QkYwMzg1OTQ2NDgzNDkKUldSSmcyU1VoUU8vZGxFRkRCQkc5T2dMTmhFK2dVR3pQSHo0WnoydVcyek9YajEzM2pEemp1WWwK"
    }
  }
}
