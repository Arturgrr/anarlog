  "logo": {
    "light": "/logo/light.svg",
    "dark": "/logo/dark.svg"
  },
  "navbar": {
    "links": [
      {
        "label": "Support",
        "href": "https://github.com/Arturgrr/librelog/issues"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Download Librelog",
      "href": "https://github.com/Arturgrr/librelog/releases"
    }
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
