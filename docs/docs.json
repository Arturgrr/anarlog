      {
        "group": "Using Librelog",
        "pages": [
          "meetings",
          "dictation",
          "automatic-capture",
          "import-recordings",
          "imports",
          "notes",
          "chat",
          "customize-summaries",
          "calendar",
          "contacts",
          "automations",
          "languages"
        ]
      },
      {
        "group": "AI and privacy",
        "pages": [
          "models-and-providers",
          "ai-setup",
          "offline",
          "data-and-privacy",
          "security"
        ]
      },
      {
        "group": "CLI and agents",
        "pages": [
          "installation",
          "agents/overview",
          "agents/cli",
          "agents/mcp",
          "agents/skills"
        ]
      },
      {
        "group": "Recipes",
        "pages": ["recipes/meeting-prep"]
      },
      {
        "group": "Reference",
        "pages": [
          "reference/cli",
          "reference/mcp",
          "reference/webhooks",
          "reference/errors"
        ]
      },
      {
        "group": "Help",
        "pages": ["help", "troubleshooting"]
      }
